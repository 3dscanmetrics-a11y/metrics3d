{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "3dscanmetrics",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_HOSTS": "www.3dscanmetrics.co.za,3dscanmetrics.co.za",
    "LEAD_NOTIFY_EMAIL": "isaiah@3dscanmetrics.co.za",
    "FROM_EMAIL": "3D Scan Metrics <estimates@3dscanmetrics.co.za>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "3dscanmetrics-crm",
      "database_id": "bbd419a9-3516-4fda-8ce9-5fcbae058271",
      "migrations_dir": "migrations"
    }
  ]
}
