{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "secrets": {
    "required": [
      "ADMIN_USERNAME",
      "ADMIN_PASSWORD",
      "RESEND_API_KEY",
      "GEMINI_API_KEY",
      "WEBHOOK_SIGNING_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "3dscanmetrics-crm",
      "database_id": "bbd419a9-3516-4fda-8ce9-5fcbae058271",
      "migrations_dir": "../site/migrations"
    }
  ]
}
